{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "version": "0.3.0",
  "identifier": "com.notes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' asset: blob: data:; img-src 'self' asset: blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com https://objects.githubusercontent.com"
    },
    "windows": [
      {
        "label": "main",
        "title": "Notes",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "copyright": "Copyright © 2026",
    "category": "Productivity",
    "shortDescription": "Sổ tay số riêng tư cho Windows",
    "longDescription": "Ứng dụng Notes giúp viết tay, đọc và chú thích PDF, quản lý sổ tay và sao lưu dữ liệu ngay trên máy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
